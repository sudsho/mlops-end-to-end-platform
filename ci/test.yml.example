# Example CI workflow. Copy to .github/workflows/test.yml when ready.
name: test

on:
  push:
    branches: [main]
  pull_request:
    branches: [main]

jobs:
  pytest:
    runs-on: ubuntu-latest
    strategy:
      matrix:
        python-version: ["3.12"]
    services:
      postgres:
        image: postgres:16
        env:
          POSTGRES_USER: feast
          POSTGRES_PASSWORD: feast
          POSTGRES_DB: feast_offline
        ports: ["5432:5432"]
        options: >-
          --health-cmd "pg_isready -U feast"
          --health-interval 5s --health-timeout 5s --health-retries 10
      redis:
        image: redis:7
        ports: ["6379:6379"]
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: ${{ matrix.python-version }}
      - name: install
        run: |
          python -m pip install -U pip
          pip install -r requirements.txt
          pip install -e .
      - name: lint
        run: ruff check src tests
      - name: test
        run: pytest -q

  build:
    runs-on: ubuntu-latest
    needs: pytest
    steps:
      - uses: actions/checkout@v4
      - name: build dashboard image
        run: docker build -t mlops-platform-dashboard:ci .
