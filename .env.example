MLOPS_ENV=dev

# Postgres (feast offline store + feast registry + mlflow backend)
POSTGRES_USER=feast
POSTGRES_PASSWORD=feast
POSTGRES_DB=feast_offline

# Redis (feast online store)
REDIS_HOST=redis
REDIS_PORT=6379

# MLflow
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_S3_ENDPOINT_URL=http://minio:9000
MLFLOW_ARTIFACT_ROOT=s3://mlops-artifacts/mlflow
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# Prefect
PREFECT_API_URL=http://prefect:4200/api
PREFECT_WORK_POOL=mlops-pool

# Dashboard
DASHBOARD_PORT=8080

# Prometheus pushgateway
PROMETHEUS_PUSHGATEWAY=http://pushgateway:9091
